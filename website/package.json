{
  "name": "nodepod-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "api": "node scripts/generate-api.mjs",
    "dev": "pnpm run api && astro dev",
    "build:site": "astro build",
    "links": "node scripts/check-links.mjs",
    "build": "pnpm run api && pnpm run build:site && pnpm run links",
    "check": "pnpm run api && astro check && pnpm run build:site && pnpm run links && node scripts/check-api-sources.mjs",
    "preview": "astro preview",
    "preview:test": "astro preview --host 127.0.0.1 --port 4321",
    "test": "playwright test"
  },
  "dependencies": {
    "@astrojs/starlight": "0.41.7",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@r1ck404/nodepod": "workspace:*",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "astro": "7.2.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.7",
    "@playwright/test": "^1.61.1",
    "@types/node": "^25.0.10",
    "typedoc": "0.28.20",
    "typedoc-plugin-frontmatter": "1.3.1",
    "typedoc-plugin-markdown": "4.12.0",
    "typescript": "^5.9.3"
  }
}
